{
  "name": "sofa-calculator",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/pre-dev.js",
    "dev": "node scripts/run-dev.js",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "version": "node -p \"require('./package.json').version\"",
    "version:patch": "./scripts/bump-version.sh patch",
    "version:minor": "./scripts/bump-version.sh minor",
    "version:major": "./scripts/bump-version.sh major",
    "release": "./scripts/release.sh",
    "env:local": "node scripts/gen-local-env.js",
    "setup:hooks": "node scripts/install-hooks.js",
    "devops": "node scripts/deploy-agent.js",
    "deploy:stage": "node scripts/deploy-agent.js deploy stage",
    "deploy:prod": "node scripts/deploy-agent.js deploy production",
    "status:stage": "node scripts/deploy-agent.js status stage",
    "status:prod": "node scripts/deploy-agent.js status production",
    "health:stage": "node scripts/deploy-agent.js health stage",
    "health:prod": "node scripts/deploy-agent.js health production",
    "logs:stage": "node scripts/deploy-agent.js logs stage",
    "logs:prod": "node scripts/deploy-agent.js logs production"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.554.0",
    "next": "^16.0.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.5.2",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@types/node": "^20.14.12",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.40",
    "tailwindcss": "^3.4.7",
    "typescript": "^5.5.4"
  }
